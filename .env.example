# ─────────────────────────────────────────────────────────────
#  SaarthiOS — server configuration
#  Copy this file to `.env` and fill in the values.
# ─────────────────────────────────────────────────────────────

# --- Core ---------------------------------------------------
NODE_ENV=development
PORT=5000

# Where the React app runs. Comma-separate to allow more than one.
CLIENT_ORIGIN=http://localhost:5173

# --- Database -----------------------------------------------
# MongoDB Atlas: Connect → Drivers → copy the string, then add
# your database name right after `.net/`.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/saarthios?retryWrites=true&w=majority

# --- Auth ---------------------------------------------------
# Any long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# --- AI provider (this is the only part you change to swap models) ---
#
#   LLM_PROVIDER  one of: openai | gemini | anthropic | groq | openrouter |
#                         together | deepseek | mistral | ollama | lmstudio | custom
#   LLM_API_KEY   the key from that provider (leave blank for local Ollama / LM Studio)
#   LLM_MODEL     optional — each provider has a sensible default
#   LLM_BASE_URL  optional — only needed for `custom` or a self-hosted endpoint
#
# Examples:
#   LLM_PROVIDER=openai      LLM_MODEL=gpt-4o-mini
#   LLM_PROVIDER=gemini      LLM_MODEL=gemini-flash-latest
#   LLM_PROVIDER=groq        LLM_MODEL=llama-3.3-70b-versatile
#   LLM_PROVIDER=ollama      LLM_MODEL=llama3.1            (no key needed)
#   LLM_PROVIDER=custom      LLM_BASE_URL=https://my-host/v1  LLM_MODEL=my-model
#
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_MS=45000

# --- Sign in with Google (optional) --------------------------
# Google Cloud Console > APIs and Services > Credentials >
# Create credentials > OAuth client ID > Web application.
# Only the Client ID is needed. There is no client secret in this flow.
# Leave blank to hide the Google button.
GOOGLE_CLIENT_ID=
MAX_CUSTOM_AGENTS=
